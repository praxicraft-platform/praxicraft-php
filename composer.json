{
  "name": "praxicraft/assess",
  "description": "Official PHP SDK for the Praxicraft Assess Public API",
  "type": "library",
  "license": "MIT",
  "homepage": "https://docs.praxicraft.com/sdks/php",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-hash": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Praxicraft\\Assess\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Praxicraft\\Assess\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable"
}
